# Portable configuration for the market service.
# Copy to .env for local development.

# Any PostgreSQL provider. The market service uses its own "market" schema.
DATABASE_URL=postgresql://predictmind:predictmind@localhost:5432/predictmind?schema=market

# Public market-data source used for importing candles.
BINANCE_API_URL=https://api.binance.com

# Binance USD-M Futures base URL, used for funding-rate / open-interest /
# long-short-ratio history (signals only — we trade spot).
BINANCE_FUTURES_API_URL=https://fapi.binance.com

# Crypto Fear & Greed Index API (free, no key). Market-wide sentiment signal.
FEAR_GREED_API_URL=https://api.alternative.me

# Coin Metrics community API (free, no key). On-chain metrics (active addresses, MVRV).
COINMETRICS_API_URL=https://community-api.coinmetrics.io

PORT=3003

# Scheduled candle sync (runs every 5 min when enabled).
SYNC_ENABLED=true
SYNC_TIMEFRAMES=1h
